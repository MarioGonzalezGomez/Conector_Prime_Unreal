{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TcpListener": {
    "Host": "0.0.0.0",
    "Port": 8283,
    "ReadBufferSize": 4096
  },
  "UnrealWebSocket": {
    "Url": "ws://127.0.0.1:30020",
    "ConnectTimeoutSeconds": 3,
    "AutoConnectOnStartup": false
  },
  "SignalStore": {
    "MaxEvents": 500
  },
  "CommandMap": {
    "Mappings": {
      "P_Directo": "PlayDirecto",
      "P_Publicidad": "PlayPublicidad",
      "P_Cortinilla": "PlayCortinilla",
      "P_Creditos": "PlayCreditos"
    }
  }
}
